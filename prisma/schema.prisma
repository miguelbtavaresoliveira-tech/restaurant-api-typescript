generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  name          String
  email         String         @unique
  password      String
  role          Role           @default(WAITER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  id            Int            @id @default(autoincrement())
  logs          AuditLog[]
  orders        Order[]        @relation("WaiterOrders")
  payments      Payment[]      @relation("WaiterPayments")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  tokenHash String   @unique
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Table {
  number       Int           @unique
  capacity     Int
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  id           Int           @id @default(autoincrement())
  comandas     Comanda[]
  reservations Reservation[]

  @@map("tables")
}

model Reservation {
  customerName  String
  customerPhone String?
  partySize     Int
  reservedFor   DateTime
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  id            Int       @id @default(autoincrement())
  tableId       Int
  table         Table     @relation(fields: [tableId], references: [id])

  @@index([tableId, reservedFor])
  @@map("reservations")
}

model Comanda {
  number        Int
  customerName  String?
  status        ComandaStatus @default(OPEN)
  serviceCharge Decimal       @default(0) @db.Decimal(5, 2)
  createdAt     DateTime      @default(now())
  closedAt      DateTime?
  id            Int           @id @default(autoincrement())
  tableId       Int
  table         Table         @relation(fields: [tableId], references: [id])
  orders        Order[]
  payments      Payment[]

  @@index([tableId, status])
  @@map("comandas")
}

model Category {
  name     String    @unique
  id       Int       @id @default(autoincrement())
  products Product[]

  @@map("categories")
}

model Product {
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  id          Int         @id @default(autoincrement())
  categoryId  Int
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model Order {
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  id        Int         @id @default(autoincrement())
  comandaId Int
  waiterId  Int?
  items     OrderItem[]
  comanda   Comanda     @relation(fields: [comandaId], references: [id])
  waiter    User?       @relation("WaiterOrders", fields: [waiterId], references: [id])

  @@index([comandaId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  id            Int           @id @default(autoincrement())
  comandaId     Int
  waiterId      Int
  comanda       Comanda       @relation(fields: [comandaId], references: [id])
  waiter        User          @relation("WaiterPayments", fields: [waiterId], references: [id])

  @@index([comandaId])
  @@map("payments")
}

model AuditLog {
  action    String
  details   Json
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CUSTOMER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum ComandaStatus {
  OPEN
  PAYMENT_PENDING
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}
